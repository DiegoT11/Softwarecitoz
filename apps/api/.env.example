# Copia este archivo a .env y llena los valores.
# Nunca subas el .env real al repo.

# --- App ---
APP_ENV=dev
LOG_LEVEL=debug
# Lista JSON de orígenes permitidos por CORS (el frontend)
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Steam Web API ---
# Se obtiene en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_API_BASE_URL=https://api.steampowered.com
STEAM_TIMEOUT_SECONDS=10
